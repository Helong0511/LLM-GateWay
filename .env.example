# 复制为仓库根目录的 .env 后再启动。本文件可以入库；.env 不可以。
# 分组：必需 / 可选 / 生产必改。
# 开发口令带 dev-only 标记。APP_ENV=production 时进程会拒绝这些口令、mock 支付和演示模型。

# ----- 必需 -----
APP_ENV=development
OPERATING_MODE=overseas
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge-dev-only
POSTGRES_DB=forge
DATABASE_URL=postgresql+asyncpg://forge:forge-dev-only@127.0.0.1:5432/forge
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_SECRET=dev-only-session-secret-change-me-32bytes
ENCRYPTION_MASTER_KEY=dev-only-encryption-master-key-32bytes
LITELLM_MASTER_KEY=sk-dev-only-litellm-master-key
LITELLM_BASE_URL=http://127.0.0.1:4000

# ----- 可选 -----
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MOCK_PAYMENTS_ENABLED=true
DEMO_MODELS_ENABLED=true
API_INTERNAL_URL=http://127.0.0.1:8000
# 登录会话：空闲超时（小时，滑动续期）；绝对上限（小时，到期必须重新登录）
# 默认 12 / 168（12 小时无操作掉线；最长 7 天）
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_HOURS=168
# 上游未返回单价时，同步写入的建议价（每 token）
DEFAULT_MODEL_INPUT_PRICE=0.00000100
DEFAULT_MODEL_OUTPUT_PRICE=0.00000200
# 备份：可填 pg_dump 绝对路径（Windows 如 C:\Program Files\PostgreSQL\16\bin\pg_dump.exe）
# 留空则自动在 PATH 与常见安装目录中查找；仍找不到且本机有 Docker 时可用镜像回退
PG_DUMP_PATH=
BACKUP_DOCKER_IMAGE=postgres:16.10-alpine
BACKUP_ALLOW_DOCKER=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=false
REDIS_PASSWORD=

# ----- 生产必改 -----
# APP_ENV=production
# OPERATING_MODE=overseas
# POSTGRES_PASSWORD=<高强度且已 URL 编码的口令>
# DATABASE_URL=postgresql+asyncpg://forge:<口令>@postgres:5432/forge
# REDIS_PASSWORD=<高强度口令>
# REDIS_URL=redis://:<口令>@redis:6379/0
# SESSION_SECRET=<至少 32 字节随机串，不得包含 dev-only>
# ENCRYPTION_MASTER_KEY=<至少 32 字节随机串，丢失将无法解密已存凭证>
# LITELLM_MASTER_KEY=<随机 sk- 长密钥>
# SESSION_IDLE_HOURS=12
# SESSION_ABSOLUTE_HOURS=168
# MOCK_PAYMENTS_ENABLED=false
# DEMO_MODELS_ENABLED=false
# 邮件必须换成真实服务商，并配置 SPF/DKIM/DMARC。不要把生产口令写回本文件。
